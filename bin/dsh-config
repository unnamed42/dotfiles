#!/usr/bin/env bash
#
# dsh-config — keep DSH's plugins and configuration under git, by content sync.
#
#   dsh-config list              which tracked files exist / drifted
#   dsh-config diff              unified diff: repo vs. what is live right now
#   dsh-config save [FILE...]    live  -> repo   (review, then `git commit`)
#   dsh-config apply [FILE...]   repo  -> live   (backs the old files up first)
#   dsh-config apply --dry-run   show what apply would touch
#
# Paths are read from <repo>/dsh-manifest.txt and are relative to both roots:
#   live: $DSH_HOME/<path>      repo: <repo>/.dsh/<path>
#
# ── Why content sync, not hard links or symlinks ─────────────────────────────
# DSH and DSH Market rewrite these files themselves, and they mix two write
# strategies:
#
#   in-place   dshmarket/lib/patch.js            writeFileSync(patchPath, ...)
#   rename     dshmarket/lib/profile.js          writeFileSync(tmp); renameSync(tmp, package.json)
#   rename     dshmarket/lib/order.js            (same temp+rename helper)
#   rm+rename  dshmarket/lib/backup.js           restoreProfileBackup() rebuilds
#                                                package.json through a temp file
#
# A rename replaces the directory entry, so it silently severs every hard link
# and turns a file symlink into a plain file. No error, no warning — the copy in
# your repo just stops moving. git makes it worse in the other direction: every
# checkout/restore/stash rewrites files in the work tree and breaks the link
# from the repo side.
#
# A file symlink is not a way out either: restoreProfileBackup() checks
# `lstatSync(target).isFile()` and aborts with "backup path is not a file" if
# package.json is a symlink — linking the profile's package.json would break
# DSH Market's install/rollback path.
#
# Content sync has no inode to break: whatever DSH does to the file, `save`
# copies bytes out and `diff` reports honestly.
#
set -euo pipefail

SCRIPT_PATH=$(readlink -f -- "${BASH_SOURCE[0]}")
REPO_DIR=$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd)
MANIFEST="$REPO_DIR/dsh-manifest.txt"
REPO_PREFIX=".dsh"
DSH_DIR=${DSH_HOME:-$HOME/.dsh}
BACKUP_ROOT="$DSH_DIR/.config-backups"
MAX_SHOWN=10

if [ -t 1 ]; then
  C_RESET=$'\033[0m'; C_DIM=$'\033[2m'; C_RED=$'\033[31m'
  C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'; C_BOLD=$'\033[1m'
else
  C_RESET=""; C_DIM=""; C_RED=""; C_GREEN=""; C_YELLOW=""; C_BOLD=""
fi

die() { printf '%s\n' "$*" >&2; exit 1; }
info() { printf '%s\n' "$*" >&2; }

usage() {
  cat <<EOF
dsh-config — keep DSH's plugins and configuration under git, by content sync.

  dsh-config list              which tracked files exist / drifted
  dsh-config diff              unified diff: repo vs. what is live right now
  dsh-config save [FILE...]    live  -> repo   (review, then \`git commit\`)
  dsh-config apply [FILE...]   repo  -> live   (backs the old files up first)
  dsh-config apply --dry-run   show what apply would touch

Tracked paths come from dsh-manifest.txt (\$DSH_HOME/<path> <-> <repo>/.dsh/<path>).

repo:  $REPO_DIR
live:  $DSH_DIR  (\$DSH_HOME)
EOF
}

require_manifest() {
  [ -f "$MANIFEST" ] || die "manifest not found: $MANIFEST"
}

# Every path in the manifest, comments and blank lines stripped.
manifest_paths() {
  require_manifest
  sed -e 's/#.*//' -e 's/[[:space:]]*$//' -e '/^[[:space:]]*$/d' "$MANIFEST"
}

live_path() { printf '%s/%s' "$DSH_DIR" "$1"; }
repo_path() { printf '%s/%s/%s' "$REPO_DIR" "$REPO_PREFIX" "$1"; }

# Resolve user-supplied FILE arguments (or fall back to the whole manifest).
# Accepts a manifest path, or a $DSH_HOME-relative / absolute path under it.
resolve_args() {
  if [ "$#" -eq 0 ]; then manifest_paths; return; fi
  local arg rel
  for arg in "$@"; do
    case "$arg" in
      /*) rel=${arg#"$DSH_DIR"/}; [ "$rel" != "$arg" ] || die "outside \$DSH_HOME: $arg" ;;
      "$REPO_PREFIX"/*) rel=${arg#"$REPO_PREFIX"/} ;;
      *) rel=$arg ;;
    esac
    if manifest_paths | grep -qxF -- "$rel"; then
      printf '%s\n' "$rel"
    else
      die "not in $MANIFEST: $rel"
    fi
  done
}

# same | changed | live-only | repo-only | missing
status_of() {
  local live repo
  live=$(live_path "$1"); repo=$(repo_path "$1")
  if [ -f "$live" ] && [ -f "$repo" ]; then
    if cmp -s -- "$live" "$repo"; then printf 'same'; else printf 'changed'; fi
  elif [ -f "$live" ]; then printf 'live-only'
  elif [ -f "$repo" ]; then printf 'repo-only'
  else printf 'missing'; fi
}

cmd_list() {
  local rel status tracked=0 drifted=0 missing=0
  printf '%s%-9s %s%s\n' "$C_BOLD" "STATUS" "FILE" "$C_RESET"
  while IFS= read -r rel; do
    tracked=$((tracked + 1))
    status=$(status_of "$rel")
    case "$status" in
      same)    printf '%s%-9s%s %s\n' "$C_GREEN" same "$C_RESET" "$rel" ;;
      changed) printf '%s%-9s%s %s\n' "$C_YELLOW" changed "$C_RESET" "$rel"; drifted=$((drifted + 1)) ;;
      live-only)  printf '%s%-9s%s %s %s(live not saved yet)%s\n' "$C_YELLOW" live-only "$C_RESET" "$rel" "$C_DIM" "$C_RESET"; drifted=$((drifted + 1)) ;;
      repo-only)  printf '%s%-9s%s %s %s(not on this machine)%s\n' "$C_DIM" repo-only "$C_RESET" "$rel" "$C_DIM" "$C_RESET" ;;
      missing)    printf '%s%-9s%s %s\n' "$C_RED" missing "$C_RESET" "$rel"; missing=$((missing + 1)) ;;
    esac
  done < <(manifest_paths)
  printf '\n%s%d tracked, %d to save, %d missing%s\n' "$C_DIM" "$tracked" "$drifted" "$missing" "$C_RESET"
  [ "$drifted" -eq 0 ]
}

cmd_diff() {
  local rel live repo n=0
  while IFS= read -r rel; do
    live=$(live_path "$rel"); repo=$(repo_path "$rel")
    [ -f "$live" ] || continue
    [ -f "$repo" ] || { printf '%s\n' "${C_YELLOW}new (live not in repo): $rel${C_RESET}"; n=$((n + 1)); continue; }
    if ! cmp -s -- "$live" "$repo"; then
      printf '%s\n' "${C_BOLD}--- $rel (repo -> live)${C_RESET}"
      diff -u --label "repo/$rel" --label "live/$rel" "$repo" "$live" || true
      n=$((n + 1))
    fi
  done < <(resolve_args "$@")
  [ "$n" -eq 0 ] && printf '%s\n' "${C_GREEN}no drift: repo matches live${C_RESET}"
  return 0
}

cmd_save() {
  local rel src dst n=0
  while IFS= read -r rel; do
    src=$(live_path "$rel"); dst=$(repo_path "$rel")
    if [ ! -f "$src" ]; then printf '%s\n' "${C_YELLOW}skip (no live file): $rel${C_RESET}"; continue; fi
    mkdir -p -- "$(dirname -- "$dst")"
    if [ -f "$dst" ] && cmp -s -- "$src" "$dst"; then continue; fi
    cp -f -- "$src" "$dst"
    chmod 644 -- "$dst" 2>/dev/null || true
    printf '%s\n' "${C_GREEN}saved${C_RESET} $rel"
    n=$((n + 1))
  done < <(resolve_args "$@")
  printf '\n%s%d file(s) updated. Review with `git -C %s diff` and commit.%s\n' "$C_DIM" "$n" "$REPO_DIR" "$C_RESET"
}

cmd_apply() {
  local dry_run=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dry-run|-n) dry_run=1; shift ;;
      --) shift; break ;;
      -*) die "unknown option: $1" ;;
      *) break ;;
    esac
  done
  local rel src dst backup_dir="" n=0
  if [ "$dry_run" -eq 0 ]; then
    backup_dir="$BACKUP_ROOT/$(date +%Y%m%d-%H%M%S)"
    mkdir -p -- "$backup_dir"
  fi
  while IFS= read -r rel; do
    src=$(repo_path "$rel"); dst=$(live_path "$rel")
    if [ ! -f "$src" ]; then printf '%s\n' "${C_YELLOW}skip (not in repo): $rel${C_RESET}"; continue; fi
    if [ -f "$dst" ] && cmp -s -- "$src" "$dst"; then continue; fi
    if [ "$dry_run" -eq 1 ]; then
      printf '%s\n' "would write $dst  ${C_DIM}(from repo/$rel)${C_RESET}"
      n=$((n + 1)); continue
    fi
    mkdir -p -- "$(dirname -- "$dst")"
    if [ -f "$dst" ]; then
      mkdir -p -- "$backup_dir/$(dirname -- "$rel")"
      cp -f -- "$dst" "$backup_dir/$rel"
    fi
    cp -f -- "$src" "$dst"
    printf '%s\n' "${C_GREEN}applied${C_RESET} $rel"
    n=$((n + 1))
  done < <(resolve_args "$@")
  if [ "$n" -eq 0 ]; then printf '%s\n' "${C_GREEN}already up to date${C_RESET}"; return 0; fi
  if [ "$dry_run" -eq 1 ]; then printf '\n%s%d file(s) would change (dry run).%s\n' "$C_DIM" "$n" "$C_RESET"; return 0; fi
  printf '\n%s%d file(s) written. Previous versions: %s%s\n' "$C_DIM" "$n" "$backup_dir" "$C_RESET"
  printf '%s\n' "${C_DIM}Restart the DSH app / re-run dsh so the new config is loaded.${C_RESET}"
}

[ "$#" -gt 0 ] && [ "$1" = "--help" ] && { usage; exit 0; }
command=${1:-list}
[ "$#" -gt 0 ] && shift

case "$command" in
  list|status) cmd_list ;;
  diff)  cmd_diff "$@" ;;
  save|pull) cmd_save "$@" ;;
  apply|load|restore) cmd_apply "$@" ;;
  help|-h) usage ;;
  *) printf 'unknown command: %s\n\n' "$command" >&2; usage >&2; exit 2 ;;
esac
